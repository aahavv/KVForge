# Sweep shape: every field free, lossy formats included, so the sweep times the
# whole design space the compiler can enumerate for this shape.
target machine = "machines/rtx5060-laptop.gpu"
target include_quantized = 1

decode mha_d64_8k_b2(H: 16, H_kv: 16, d: 64, n: 8192, batch: 2) {
  Q: query<H, d, f32>
  K: kvcache<n, d, ?, ?, ?>
  V: kvcache<n, d, ?, ?, ?>
  O = decode_attn(Q, K, V, scale = auto, splits = ?, gqa_pack = ?)
}
