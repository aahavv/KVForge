# A portable stand-in so the examples run before anyone probes a real GPU.
# Replace it with the output of bench/bw_probe for numbers that mean anything:
#   bw_probe.exe --out machines/this-gpu.gpu
name = generic-gpu
compute_capability = 0
dram_gb = 8
sms = 24
bw_peak_gbs = 250
bw_sm_gbs = 18
lat_ns = 600
bw_l2_gbs = 1200
l2_bytes = 33554432
sector_bytes = 32
line_bytes = 128
f32_gflops = 10000
launch_us = 3
max_warps_per_sm = 48
max_blocks_per_sm = 24
