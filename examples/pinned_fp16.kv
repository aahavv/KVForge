# Everything pinned: one format, one layout, no splitting, no GQA packing. This
# is the baseline a straightforward hand-written decode kernel implements, and
# what the searched plans have to beat. It differs from the searched program
# only by question marks.
target machine = "machines/generic-gpu.gpu"

decode baseline_fp16(H: 32, H_kv: 8, d: 128, n: 32768, batch: 1) {
  Q: query<H, d, f32>
  K: kvcache<n, d, f16, token_major, contiguous>
  V: kvcache<n, d, f16, token_major, contiguous>
  O = decode_attn(Q, K, V, scale = auto, splits = 1, gqa_pack = false)
}
